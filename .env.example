# ==========================================
# SocialPilot AI - Environment Configuration
# ==========================================

# ------------------------------------------
# Application
# ------------------------------------------
APP_NAME=SocialPilot AI
APP_ENV=development
DEBUG=true

# ------------------------------------------
# Backend
# ------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------
# Database
# ------------------------------------------
DATABASE_URL=postgresql+asyncpg://socialpilot:password@localhost:5432/socialpilot

# ------------------------------------------
# Redis
# ------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------
# Authentication
# ------------------------------------------
JWT_SECRET=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------
# LLM Provider
# ------------------------------------------
LLM_PROVIDER=ollama

# Local development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Cloud provider - optional
OPENAI_API_KEY=

# ------------------------------------------
# Embeddings / RAG
# ------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# ------------------------------------------
# X / Twitter Integration
# ------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/auth/x/callback

# ------------------------------------------
# Application URLs
# ------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000